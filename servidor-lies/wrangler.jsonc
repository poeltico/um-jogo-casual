{
  // Worker das salas do Lies (publicado em https://lies-salas.poeltico.workers.dev)
  "name": "lies-salas",
  "main": "src/index.js",
  "compatibility_date": "2025-11-01",
  "durable_objects": {
    "bindings": [{ "name": "SALAS", "class_name": "Sala" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sala"] }],
  "observability": { "enabled": true }
}
